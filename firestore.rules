rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Air-hockey signaling room.
    // Public-by-design: anyone with a 6-char room code can read/write that
    // room and its candidate subcollections. The room codes are unguessable
    // enough for casual use; for production add auth + scoped rules.
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{path=**} {
        allow read, write: if true;
      }
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
