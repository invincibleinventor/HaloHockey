rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read/write under /rooms/* — covers the room doc itself
    // (e.g. /rooms/ABCDEF) AND every nested candidate subcollection
    // (e.g. /rooms/ABCDEF/offerCandidates/xyz).
    match /rooms/{document=**} {
      allow read, write: if true;
    }
  }
}
